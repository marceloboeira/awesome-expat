---
import { categories, countries, jobs, roles, global, contribute, repo } from '../lib/routes.ts';

interface Props {
  path: string;
}
const { path } = Astro.props;

const nav = [
  { href: countries(), label: 'Countries' },
  { href: categories(), label: 'Categories' },
  { href: roles(), label: 'Roles' },
  { href: jobs(), label: 'Jobs' },
  { href: global(), label: 'Global' },
];

/**
 * No JavaScript.
 *
 * The site is a reference directory; the only interactivity worth shipping is
 * the one that cannot be done in CSS, and there is not much of it. A mobile
 * nav therefore uses a checkbox rather than a script, so the menu works before
 * hydration and with JS disabled.
 */
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight shrink-0" aria-label="Awesome Expat home">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" class="text-accent">
        <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.75" />
        <path d="M2 12h20M12 2c2.6 2.7 2.6 17.3 0 20M12 2c-2.6 2.7-2.6 17.3 0 20"
              fill="none" stroke="currentColor" stroke-width="1.25" opacity=".55" />
      </svg>
      <span class="text-[length:var(--text-step-0)]">Awesome&nbsp;Expat</span>
    </a>

    <nav aria-label="Main" class="hidden md:block ml-2">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded px-2.5 py-1.5 text-[length:var(--text-step--1)] transition-colors',
                  isActive(item.href)
                    ? 'bg-accent-soft text-accent font-medium'
                    : 'text-ink-soft hover:text-ink hover:bg-paper-sunk',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={repo()}
        target="_blank"
        rel="noopener"
        class="hidden rounded p-1.5 text-ink-soft transition-colors hover:bg-paper-sunk hover:text-ink sm:inline-flex"
        aria-label="Awesome Expat on GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .75-.24 2.47.92a6.9 6.9 0 0 1 2.24-.3c.76 0 1.52.1 2.24.3 1.71-1.16 2.46-.92 2.46-.92.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
      <a
        href={contribute()}
        class="hidden sm:inline-block rounded bg-ink px-3 py-1.5 text-[length:var(--text-step--1)] font-medium text-paper transition-opacity hover:opacity-85"
      >
        Add a link
      </a>

      <!-- Checkbox-driven disclosure. No script, works with JS off. -->
      <input type="checkbox" id="nav-toggle" class="peer sr-only" aria-hidden="true" tabindex="-1" />
      <label
        for="nav-toggle"
        class="md:hidden cursor-pointer rounded p-1.5 text-ink-soft hover:bg-paper-sunk peer-checked:hidden"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </label>
      <label
        for="nav-toggle"
        class="md:hidden hidden cursor-pointer rounded p-1.5 text-ink-soft hover:bg-paper-sunk peer-checked:block"
        aria-label="Close menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </label>
    </div>
  </div>

  <div class="peer-checked:block hidden md:hidden border-t border-rule bg-paper">
    <nav aria-label="Mobile" class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      <ul class="grid gap-0.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded px-3 py-2.5 text-[length:var(--text-step-0)]',
                  isActive(item.href) ? 'bg-accent-soft text-accent font-medium' : 'text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 border-t border-rule pt-2">
          <a href={contribute()} class="block rounded px-3 py-2.5 text-[length:var(--text-step-0)] font-medium text-accent">
            Add a link
          </a>
        </li>
        <li>
          <a
            href={repo()}
            target="_blank"
            rel="noopener"
            class="block rounded px-3 py-2.5 text-[length:var(--text-step-0)] text-ink-soft"
          >
            View on GitHub
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
