{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["engine/lib/*"]
    }
  },
  "include": ["engine/**/*.ts", "src/**/*.ts", "src/**/*.astro", "*.mjs"],
  "exclude": ["node_modules", "dist", ".astro", ".agents"]
}
